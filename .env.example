# RV Files environment reference. Copy to .env and edit; .env is git-ignored.
# Never commit real credentials.

# Trust X-Forwarded-For so rate limits and the tripwire see the real client IP.
# Set to true only when a reverse proxy sits in front of the container.
# docker-compose.yml uses false; docker-compose.local.yml uses true with 2 hops
# (Caddy inside the container + a cloudflared tunnel in front).
TRUST_PROXY=false
# Number of proxies in front of the backend, including the container's own Caddy.
# TRUST_PROXY_HOPS=2

# Ports: the container's Caddy listens on 3000, the frontend on 3333 and the
# backend on 8080. Leave PORT unset: Caddy also reads PORT for its frontend
# upstream. On a PaaS (Railway, Fly, Render), point the public port at 3000.
# Set BACKEND_PORT only if you need to move the API listener.
# BACKEND_PORT=8080

# Persist data with a volume mounted at /opt/app/backend/data
# (SQLite database and uploaded files).

# Optional: MongoDB connection string for the tamper-evident audit log.
# When unset, audit logging is off and the app works normally.
# The database name comes from the URI path.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/rvfiles
